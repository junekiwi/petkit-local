# Copy to `.env` and fill these in. Compose reads that file automatically, and
# `.env` is gitignored — so your addresses stay out of the repository and
# `git pull` never conflicts with them.
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d

# The address the DEVICE will call, and the most important value here. It must
# be an IP or a name the device itself can resolve — most PetKit hardware
# cannot resolve .local names — and it is burned into the device at
# provisioning, so pick one that will not move.
#
# Include the port if you changed the left-hand side of the `80:8080` mapping
# in docker-compose.yml. The trailing `/6/` is part of the API path, not a
# typo.
PETKIT_API_URL=http://192.168.1.10/6/

# Your Home Assistant MQTT broker, so entities appear via MQTT discovery.
# Leave the whole `--ha-mqtt-host` line out of docker-compose.yml (or pass
# --no-ha) to run with no Home Assistant at all: the web panel and the local
# cloud work regardless.
PETKIT_HA_MQTT_HOST=192.168.1.10

# Your timezone, as a tz database name (`Europe/Warsaw`, `America/New_York`).
# Days are cut at local midnight, and left out, the container runs on UTC: at
# UTC+2 the day's counts would reset at 02:00, and the Timeline would show the
# small hours under yesterday.
TZ=Europe/Warsaw
